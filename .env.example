NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_DATA_API_KEY=
CRON_SECRET=
SLACK_WEBHOOK_URL=
NEXT_PUBLIC_BANK_TRANSFER_INFO=
# Public origins of the two apps (used for cross-app links and OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Encrypts creator resident numbers; losing it makes them unreadable.
PAYOUT_ENCRYPTION_KEY=
# Pre-launch lock: when set, the site and app ask for this password (HTTP Basic, any user name). Cron routes and
# robots.txt stay open. Remove it and redeploy both apps to launch (the site's robots.txt is fixed at build).
PRELAUNCH_PASSWORD=
